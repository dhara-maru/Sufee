@page
@model SUFEEASP.Pages.Admin.Qawwalis.DeleteModel

@{
    ViewData["Title"] = "Delete";
}

<div style="margin: 20px; margin-left: 40px; padding: 20px; padding-top: 10px; max-width: 100%; box-sizing: border-box; display: flex; justify-content: center;">
    <div style="max-width: 800px; width: 100%;">
        <h1 style="font-size: 2rem;">Delete</h1>
        <h3 style="font-size: 2rem; margin-bottom: 2px;">Are you sure you want to delete this Qawwali?</h3>

        <div style="display: flex; flex-wrap: wrap; gap: 20px;">
            <div style="flex: 1; min-width: 250px; display: flex; flex-direction: column; gap: 15px;">
                <div style="display: flex; flex-direction: column; gap: 5px;">
                    <dt style="font-weight: 500; font-size: 1.9rem; color: #34495e;">@Html.DisplayNameFor(model => model.Qawwali.Title)</dt>
                    <dd style="font-size: 1.9rem; color: #495057;">@Html.DisplayFor(model => model.Qawwali.Title)</dd>
                </div>
                <div style="display: flex; flex-direction: column; gap: 5px;">
                    <dt style="font-weight: 500; font-size: 1.9rem; color: #34495e;">@Html.DisplayNameFor(model => model.Qawwali.Poetname)</dt>
                    <dd style="font-size: 1.9rem; color: #495057;">@Html.DisplayFor(model => model.Qawwali.Poetname)</dd>
                </div>
            </div>

            <form method="post" style="width: 100%; display: flex; justify-content: center; gap: 15px; margin-top: 20px;">
                <input type="hidden" asp-for="Qawwali.ID" />
                <input type="submit" value="Delete" class="btn btn-danger" style="padding: 10px 20px; font-size: 1rem; width: 150px;" />
                <a asp-page="./Index" class="btn btn-secondary" style="padding: 10px 20px; font-size: 1rem; width: 150px; text-decoration: none;">Back to List</a>
            </form>
        </div>
    </div>
</div>
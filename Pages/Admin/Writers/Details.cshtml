@page
@model SUFEEASP.Pages.Admin.Writers.DetailsModel

@{
    ViewData["Title"] = "Details";
}

<div style="margin: 20px; margin-left: 40px; padding: 20px; padding-top: 10px; max-width: 100%; box-sizing: border-box; display: flex; justify-content: center;">
    <div style="max-width: 800px; width: 100%;">
        <h1 style="font-size: 2rem; margin-bottom: 15px;">Writer Details</h1>

        <div style="display: flex; flex-wrap: wrap; gap: 20px;">
            <div style="flex: 1; min-width: 250px; display: flex; flex-direction: column; gap: 15px;">
                <div style="display: flex; flex-direction: column; gap: 5px;">
                    <dt style="font-weight: 500; font-size: 1.9rem; color: Black; text-decoration: underline">@Html.DisplayNameFor(model => model.Writer.City)</dt>
                    <dd style="font-size: 1.9rem; color: #495057;">@Html.DisplayFor(model => model.Writer.City)</dd>
                </div>
                <div style="display: flex; flex-direction: column; gap: 5px;">
                    <dt style="font-weight: 500; font-size: 1.9rem; color: Black; text-decoration: underline">@Html.DisplayNameFor(model => model.Writer.Name)</dt>
                    <dd style="font-size: 1.9rem; color: #495057;">@Html.DisplayFor(model => model.Writer.Name)</dd>
                </div>
                <div style="display: flex; flex-direction: column; gap: 5px;">
                    <dt style="font-weight: 500; font-size: 1.9rem; color: Black; text-decoration: underline">@Html.DisplayNameFor(model => model.Writer.Desc1)</dt>
                    <dd style="font-size: 1.9rem; color: #495057;">@Html.DisplayFor(model => model.Writer.Desc1)</dd>
                </div>
                <div style="display: flex; flex-direction: column; gap: 5px;">
                    <dt style="font-weight: 500; font-size: 1.9rem; color: Black; text-decoration: underline">@Html.DisplayNameFor(model => model.Writer.Desc2)</dt>
                    <dd style="font-size: 1.9rem; color: #495057;">@Html.DisplayFor(model => model.Writer.Desc2)</dd>
                </div>
                <div style="display: flex; flex-direction: column; gap: 5px;">
                    <dt style="font-weight: 500; font-size: 1.9rem; color: Black; text-decoration: underline">@Html.DisplayNameFor(model => model.Writer.Imgurl)</dt>
                    <dd style="font-size: 1.9rem; color: #495057;">@Html.DisplayFor(model => model.Writer.Imgurl)</dd>
                </div>
                <div style="display: flex; flex-direction: column; gap: 5px;">
                    <dt style="font-weight: 500; font-size: 1.9rem; color: Black; text-decoration: underline">@Html.DisplayNameFor(model => model.Writer.DOB)</dt>
                    <dd style="font-size: 1.9rem; color: #495057;">@Html.DisplayFor(model => model.Writer.DOB)</dd>
                </div>
            </div>

            <div style="flex: 1; min-width: 250px; display: flex; flex-direction: column; gap: 15px;">
                <div style="display: flex; flex-direction: column; gap: 5px;">
                    <dt style="font-weight: 500; font-size: 1.9rem; color: Black; text-decoration: underline">@Html.DisplayNameFor(model => model.Writer.DOD)</dt>
                    <dd style="font-size: 1.9rem; color: #495057;">@Html.DisplayFor(model => model.Writer.DOD)</dd>
                </div>
                <div style="display: flex; flex-direction: column; gap: 5px;">
                    <dt style="font-weight: 1.9rem; font-size: 1.9rem; color: Black; text-decoration: underline">@Html.DisplayNameFor(model => model.Writer.WriterType)</dt>
                    <dd style="font-size: 1.9rem; color: #495057;">@Html.DisplayFor(model => model.Writer.WriterType)</dd>
                </div>
                <div style="display: flex; flex-direction: column; gap: 5px;">
                    <dt style="font-weight: 500; font-size: 1.9rem; color: Black; text-decoration: underline">@Html.DisplayNameFor(model => model.Writer.Quote)</dt>
                    <dd style="font-size: 1.9rem; color: #495057;">@Html.DisplayFor(model => model.Writer.Quote)</dd>
                </div>
                <div style="display: flex; flex-direction: column; gap: 5px;">
                    <dt style="font-weight: 500; font-size: 1.9rem; color: Black; text-decoration: underline">@Html.DisplayNameFor(model => model.Writer.Famous)</dt>
                    <dd style="font-size: 1.9rem; color: #495057;">@Html.DisplayFor(model => model.Writer.Famous)</dd>
                </div>
                <div style="display: flex; flex-direction: column; gap: 5px;">
                    <dt style="font-weight: 500; font-size: 1.9rem; color: Black; text-decoration: underline">@Html.DisplayNameFor(model => model.Writer.ViewMore)</dt>
                    <dd style="font-size: 1.9rem; color: #495057;">@Html.DisplayFor(model => model.Writer.ViewMore)</dd>
                </div>
            </div>

            <div style="width: 100%; display: flex; justify-content: center; gap: 15px; margin-top: 20px;">
                <a asp-page="./Edit" asp-route-id="@Model.Writer.ID" class="btn btn-primary" style="padding: 10px 20px; font-size: 1rem; width: 150px; text-decoration: none;">Edit</a>
                <a asp-page="./Index" class="btn btn-secondary" style="padding: 10px 20px; font-size: 1rem; width: 150px; text-decoration: none;">Back to List</a>
            </div>
        </div>
    </div>
</div>
@{
    ViewData["Title"] = "Contact";
}
<!-- content
================================================== -->
<section class="s-content">

    <div class="row">
        <div class="column large-12">

            <article class="s-content__entry">

               

                <div class="s-content__entry-header">
                    <h1 class="s-content__title">Get In Touch With Us.</h1>
                </div> <!-- end s-content__entry-header -->

                <div class="s-content__primary">

                    <div class="s-content__page-content">

                        <p class="lead">
                            We at Sufee believe that poetry is a form of prayer, and every message from you matters.
                            Whether you’re here to discover timeless Sufi verses or share your thoughts on the beauty
                            you’ve found — we’d love to hear from you.
                        </p>

                        <p>
                            Our team is based in the heart of Mumbai, where the old world meets new rhythms. Reach out,
                            visit us, or just drop by through the map below — either way, you’re always welcome in the
                            world of Sufee.
                        </p>

                        <br>

                        <div class="row block-large-1-2 block-tab-full s-content__blocks">
                            <div class="column">
                                <h4>Where to Find Us</h4>
                                <p>
                                    Rosewood Chambers, Hill Road<br>
                                    Bandra West, Mumbai<br>
                                    Maharashtra 400050, India
                                </p>
                            </div>

                            <div class="column">
                                <h4>Contact Info</h4>
                                <p>
                                    sufee@poetryverse.com<br>
                                    hello@sufee.in <br>
                                    Phone: (+91) 93210 12345
                                </p>
                            </div>
                        </div> <!-- end s-content__blocks -->

                        <!-- Replaced Form with Google Map -->
                        <div style="margin-top: 2rem;">
                            <iframe
                                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3769.836351416183!2d72.82953487517817!3d19.11637978209859!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3be7c91870b9fc35%3A0xe26f7f2ef6208fae!2sBandra%20West%2C%20Mumbai%2C%20Maharashtra%20400050!5e0!3m2!1sen!2sin!4v1714462068901!5m2!1sen!2sin"
                                width="100%" height="450" style="border:0; border-radius: 8px;" allowfullscreen=""
                                loading="lazy" referrerpolicy="no-referrer-when-downgrade" style="
    max-width: 100%;
    height: 448px;
">
                            </iframe>
                        </div>

                    </div> <!-- end s-entry__page-content -->

                </div> <!-- end s-content__primary -->
            </article> <!-- end entry -->

        </div> <!-- end column -->

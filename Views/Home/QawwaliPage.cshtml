@model List<SUFEEASP.Model.Qawwali>
@{
    ViewData["Title"] = "Qawwalis";
}

<!-- AOS CSS -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.css" />

<section class="s-content s-content--no-top-padding">
    <h2 class="sectionheading" style="text-align: center; padding-top: 68px; margin-bottom: -40px;">
        Soulful Qawwalis on Sufee
    </h2>
    <div class="s-bricks">
        <div class="masonry">
            <div class="bricks-wrapper h-group">
                <div class="grid-sizer"></div>
                <div class="lines"><span></span><span></span><span></span></div>

                @if (Model != null && Model.Any())
                {
                    foreach (var qawwali in Model)
                    {
                        <article class="brick entry" data-aos="fade-up"
                                 style="display: flex; flex-direction: column; justify-content: space-between; height: 500px;">
                            <div class="entry__thumb" style="height: 270px; overflow: hidden; border-radius: 6px;">
                                <a href="@Url.Action("QawwaliDetails", "Home", new { id = qawwali.ID })" class="thumb-link">
                                    <img src="@qawwali.Imgurl"
                                         alt="@qawwali.Title"
                                         style="width: 100%; height: 100%; object-fit: cover;" />
                                </a>
                            </div>
                            <div class="entry__text" style="flex: 1; display: flex; flex-direction: column; justify-content: space-between; margin-top: 10px;">
                                <div>
                                    <div class="entry__header">
                                        <h1 class="entry__title" style="font-size: 18px; min-height: 60px;">
                                            <a href="@Url.Action("QawwaliDetails", "Home", new { id = qawwali.ID })">@qawwali.Title</a>
                                        </h1>
                                        <div class="entry__meta">
                                            <span class="byline">
                                                Poet:
                                                <span class="author"><a href="#">@qawwali.Poetname</a></span>
                                            </span>
                                            <span class="cat-links">
                                                <a href="@Url.Action("QawwaliDetails", "Home", new { id = qawwali.ID })">Listen Now</a>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                                <a class="entry__more-link" href="@Url.Action("QawwaliDetails", "Home", new { id = qawwali.ID })"
                                   style="margin-top: auto; color: #007BFF;">View Qawwali</a>
                            </div>
                        </article>
                    }
                }
                else
                {
                    <p style="text-align: center; margin-top: 40px;">No qawwalis available at the moment.</p>
                }
            </div>
        </div>
    </div>
</section>

<!-- AOS JS -->
<script src="https://cdn.jsdelivr.net/npm/aos@2.3.4/dist/aos.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        AOS.init();
    });
</script>
@{
    ViewData["Title"] = "Welcome Back";
}
<style>
    .form-container {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        height: 100vh;
        width: 100%;
        padding: 1rem;
    }

    .form-content {
        width: 100%;
        max-width: 400px;
    }

        .form-content h2 {
            text-align: center;
            margin-bottom: 1.9rem;
            font-size: 2.5rem;
        }

        .form-content p {
            text-align: center;
            color: #6c757d;
            margin-bottom: 1.5rem;
            font-size: 1.9rem;
        }

    .error-message {
        text-align: center;
        color: #dc3545;
        margin-bottom: 1.5rem;
        font-size: 1.9rem;
    }

    .form-group {
        margin-bottom: 1.5rem;
    }

        .form-group label {
            display: block;
            font-weight: 500;
            margin-bottom: 0.5rem;
            font-size: 1.9rem;
        }

        .form-group input {
            width: 100%;
            padding: 0.75rem;
            border: 1px solid #ced4da;
            border-radius: 4px;
            font-size: 1.9rem;
        }

    .btn-primary {
        width: 100%;
        padding: 0.75rem;
        background-color: black;
        border: none;
        border-radius: 4px;
        color: white;
        font-size: 1.4rem;
        cursor: pointer;
        transition: background-color 0.3s;
    }

        .btn-primary:hover {
            background-color: grey;
        }
</style>
<div class="form-container">
    <div class="form-content">
        <h2>Welcome Back</h2>
        <p>Log in to access your account.</p>
        @if (ViewBag.Error != null)
        {
            <p class="error-message">@ViewBag.Error</p>
        }
        <form asp-controller="Home" action="@Url.Action("LoginPost", "Home")" method="post">
            <div class="form-group">
                <label for="Email">Email</label>
                <input type="email" id="Email" name="Email" required />
            </div>
            <div class="form-group">
                <label for="Password">Password</label>
                <input type="password" id="Password" name="Password" required />
            </div>
            <button type="submit" class="btn-primary">Log In</button>
        </form>
    </div>
</div>
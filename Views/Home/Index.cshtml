@model SUFEEASP.Model.HomeViewModel

@{
    ViewData["Title"] = "Home";
}


<section id="hero" class="s-hero">
    <div class="s-hero__slider">

        @foreach (var blog in Model.Blogs)
        {
            <div class="s-hero__slide">
                <div class="s-hero__slide-bg" style="background-image: url('@blog.Blogimg1');"></div>

                <div class="row s-hero__slide-content animate-this">
                    <div class="column">
                        <div class="s-hero__slide-meta">
                            <span class="cat-links">
                                @foreach (var tag in blog.Category.Split(','))
                                {
                                    <a href="#">@tag.Trim()</a>
                                }
                            </span>
                            <span class="byline">
                                Posted by
                                <span class="author">
                                    <a href="#">@blog.Author</a>
                                </span>
                            </span>
                        </div>
                        <h1 class="s-hero__slide-text">
                            <a href="@Url.Action("BlogDetails", "Home", new { id = blog.ID })">
                                @blog.Title
                            </a>
                        </h1>
                    </div>
                </div>
            </div>
        }

    </div> <!-- end s-hero__slider -->

    <div class="s-hero__social hide-on-mobile-small">
        <p>Follow</p>
        <span></span>
        <ul class="s-hero__social-icons">
            <li><a href="#"><i class="fab fa-facebook-f" aria-hidden="true"></i></a></li>
            <li><a href="#"><i class="fab fa-twitter" aria-hidden="true"></i></a></li>
            <li><a href="#"><i class="fab fa-instagram" aria-hidden="true"></i></a></li>
            <li><a href="#"><i class="fab fa-dribbble" aria-hidden="true"></i></a></li>
        </ul>
    </div>

    <div class="nav-arrows s-hero__nav-arrows">
        <button class="s-hero__arrow-prev">
            <svg viewBox="0 0 15 15" xmlns="http://www.w3.org/2000/svg" width="15" height="15">
                <path d="M1.5 7.5l4-4m-4 4l4 4m-4-4H14" stroke="currentColor"></path>
            </svg>
        </button>
        <button class="s-hero__arrow-next">
            <svg viewBox="0 0 15 15" xmlns="http://www.w3.org/2000/svg" width="15" height="15">
                <path d="M13.5 7.5l-4-4m4 4l-4 4m4-4H1" stroke="currentColor"></path>
            </svg>
        </button>
    </div>
</section>

<!-- Quote Section -->
<h2 class="sectionheading" style="text-align: center; padding-top: 68px; margin-bottom: -40px;">
        Quote Of The Day
    </h2>
@if (Model.Quote != null)
{
    <blockquote style="margin: 40px auto; max-width: 800px; text-align: center; font-style: italic;">
        <p>@Model.Quote.QuoteContent</p>
        <cite style="display: block; margin-top: 10px; color: black; font-size : 1.5rem">@Model.Quote.Quoter</cite>
    </blockquote>
}
else
{
    <blockquote style="margin: 40px auto; max-width: 800px; text-align: center; font-style: italic;">
        <p>No quote available.</p>
    </blockquote>
}

<!-- E-Book Section -->
<section class="s-content s-content--no-top-padding">
    <h2 class="sectionheading" style="text-align: center; padding-top: 68px; margin-bottom: -40px;">
        Best Seller Sufi & Urdu E-Books
    </h2>
    <div class="s-bricks">
        <div class="masonry">
            <div class="bricks-wrapper h-group">
                <div class="grid-sizer"></div>
                <div class="lines"><span></span><span></span><span></span></div>

                @if (Model.Ebooks != null)
                {
                    foreach (var book in Model.Ebooks)
                    {
                        <article class="brick entry"
                                 style="display: flex; flex-direction: column; justify-content: space-between;">
                            <div class="entry__thumb" style="max-height: 230px; overflow: hidden;">
                                <a href="@book.Booklink" class="thumb-link" target="_blank">
                                    <img src="@book.Imgurl" alt="@book.Name"
                                         style="width: 100%; height: auto; object-fit: cover;" />
                                </a>
                            </div>
                            <div class="entry__text" style="flex: 1; display: flex; flex-direction: column;">
                                <div>
                                    <div class="entry__header">
                                        <h1 class="entry__title" style="font-size: 18px; min-height: 60px;">
                                            <a href="@book.Booklink" target="_blank">@book.Name</a>
                                        </h1>
                                        <div class="entry__meta">
                                            <span class="byline">
                                                By:
                                                <span class="author"><a href="#">@book.Author</a></span>
                                            </span>
                                            <span class="cat-links"><a href="#">E-Book</a></span>
                                        </div>
                                    </div>
                                </div>
                                <a class="entry__more-link" href="@book.Booklink" target="_blank">View E-Book</a>
                            </div>
                        </article>
                    }
                }
            </div>
        </div>
    </div>
</section>

<!-- Blog Section -->
<section class="s-content s-content--no-top-padding">
    <h2 class="sectionheading" style="text-align: center; padding-top: 68px; margin-bottom: -40px;">
        Popular Blogs on Sufee
    </h2>
    <div class="s-bricks">
        <div class="masonry">
            <div class="bricks-wrapper h-group">
                <div class="grid-sizer"></div>
                <div class="lines"><span></span><span></span><span></span></div>

                @if (Model.Blogs != null)
                {
                    foreach (var blog in Model.Blogs)
                    {
                        <article class="brick entry"
                                 style="display: flex; flex-direction: column; justify-content: space-between; height: 100%; min-height: 420px; border: 1px solid #eee; padding: 10px;">
                            <div class="entry__thumb" style="height: 200px; overflow: hidden; border-radius: 6px;">
                                <a href="@Url.Action("BlogDetails", "Home", new { id = blog.ID })">
                                    <img src="@blog.Blogimg1" alt="@blog.Title"
                                         style="width: 100%; height: 100%; object-fit: cover;" />
                                </a>
                            </div>
                            <div class="entry__text" style="flex-grow: 1; display: flex; flex-direction: column; margin-top: 10px;">
                                <div>
                                    <div class="entry__header">
                                        <h1 class="entry__title" style="font-size: 18px; min-height: 60px;">
                                            <a href="@Url.Action("BlogDetails", "Home", new { id = blog.ID })">@blog.Title</a>
                                        </h1>
                                        <div class="entry__meta">
                                            <span class="byline">
                                                Author:
                                                <span class="author"><a href="@Url.Action("BlogDetails", "Home", new { id = blog.ID })">@blog.Author</a></span>
                                            </span>
                                            <span class="cat-links">
                                                <a href="@Url.Action("BlogDetails", "Home", new { id = blog.ID })">Blog</a>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                                <a class="entry__more-link" href="@Url.Action("BlogDetails", "Home", new { id = blog.ID })" style="margin-top: auto;">Read Blog</a>
                            </div>
                        </article>
                    }
                }
            </div>
        </div>
    </div>
</section>

